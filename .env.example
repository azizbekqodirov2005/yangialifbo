# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# .env fayli hech qachon GitHub'ga yuklanmasin (.gitignore da bor).

PORT=3000

# AI xizmati: anthropic | openai | gemini
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Imlo tekshiruvi cheklovlari
MAX_PROOFREAD_CHARS=20000
RATE_LIMIT_WINDOW_MIN=10
RATE_LIMIT_MAX=20

# Nginx/Cloudflare ortida ishlatsangiz: 1
# TRUST_PROXY=1
